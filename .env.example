# IBM Watsonx credentials
IBM_API_KEY=your_ibm_api_key_here
IBM_PROJECT_ID=your_ibm_project_id_here
IBM_CLOUD_URL=https://us-south.ml.cloud.ibm.com

# City Ops bearer token (used to secure the /reports and /reports/{id}/status endpoints)
CITY_OPS_TOKEN=generate_a_strong_random_token_here

# City dashboard login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose_a_strong_password

# Africa's Talking SMS (get free sandbox at africastalking.com)
AT_USERNAME=sandbox
AT_API_KEY=your_africas_talking_api_key_here
